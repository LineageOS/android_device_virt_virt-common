prebuilt_root {
    name: "virt_pci_ids",
    src: "pci.ids",
    vendor: true,
    filename_from_src: true,
    licenses: ["virt_pci_ids_license"],
    enabled: select(soong_config_variable("device_virt_virt_common", "enabled"), {
        true: true,
        default: false,
    }),
}

license {
    name: "virt_pci_ids_license",
    package_name: "PCI IDS",
    license_kinds: ["SPDX-license-identifier-BSD-3-Clause"],
    license_text: ["LICENSE_BSD"],
}
